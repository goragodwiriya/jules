# Enable URL Rewriting
RewriteEngine On

# Ignore existing files and directories from being rewritten
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rewrite API requests to the API router
# e.g., /api/forms/1 -> /api/index.php?path=forms/1
RewriteRule ^api/(.*)$ api/index.php?path=$1 [QSA,L]
